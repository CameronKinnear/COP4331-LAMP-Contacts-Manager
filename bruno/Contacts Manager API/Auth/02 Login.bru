meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPath}}/index.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "login": "{{testLogin}}",
    "password": "{{testPassword}}"
  }
}

vars:pre-request {
  baseUrl: https://goliveira.site
  apiPath: /api
  testLogin: testing7
  testPassword: testing7
}

assert {
  res.status: 200
  res.body.error: ""
}
